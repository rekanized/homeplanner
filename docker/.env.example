# Optional application settings for custom Docker deployments.
# The docker-compose.yml example works without an environment file.
# Add overrides under app.environment in docker-compose.yml when needed.
APP_NAME=Homeplanner
APP_URL=http://localhost:8080
APP_LOCALE=en
# APP_KEY is generated and stored automatically when omitted.
# Set this when using an HTTPS reverse proxy:
# SESSION_SECURE_COOKIE=true
